---
# ResourceSetInputProvider — polls Forgejo API for open PRs
apiVersion: fluxcd.controlplane.io/v1
kind: ResourceSetInputProvider
metadata:
  name: webapp-pull-requests
  namespace: {{ gitops_namespace }}
  annotations:
    fluxcd.controlplane.io/reconcile: "enabled"
    fluxcd.controlplane.io/reconcileEvery: "5m"
spec:
  type: GiteaPullRequest
  url: {{ forgejo_base_url }}/{{ app_repo }}
  secretRef:
    name: forgejo-gitops-auth
  certSecretRef:
    name: forgejo-ca-cert
  filter:
    limit: 10
    labels:
      - preview-built
---
# ResourceSet — creates preview namespace + source + Kustomization per PR
apiVersion: fluxcd.controlplane.io/v1
kind: ResourceSet
metadata:
  name: webapp-pr-previews
  namespace: {{ gitops_namespace }}
spec:
  serviceAccountName: kustomize-controller
  inputsFrom:
    - apiVersion: fluxcd.controlplane.io/v1
      kind: ResourceSetInputProvider
      name: webapp-pull-requests
  resources:
    - apiVersion: v1
      kind: Namespace
      metadata:
        name: webapp-pr-<< inputs.id >>
    - apiVersion: source.toolkit.fluxcd.io/v1
{% if gitless %}
      kind: OCIRepository
{% else %}
      kind: GitRepository
{% endif %}
      metadata:
        name: webapp-pr-<< inputs.id >>
        namespace: {{ gitops_namespace }}
      spec:
        interval: 5m
{% if gitless %}
        url: {{ sample_webapp_pr_oci_url }}
        ref:
          tag: pr-<< inputs.id >>-<< printf "%.7s" inputs.sha >>
        certSecretRef:
          name: forgejo-ca-cert
{% else %}
        url: {{ repo_url }}
        ref:
          branch: main
        secretRef:
          name: forgejo-gitops-auth
{% endif %}
    - apiVersion: kustomize.toolkit.fluxcd.io/v1
      kind: Kustomization
      metadata:
        name: webapp-pr-<< inputs.id >>
        namespace: {{ gitops_namespace }}
      spec:
        interval: 5m
        prune: true
{% if gitless %}
        path: ./
{% else %}
        path: ./apps/sample-webapp/overlays/preview
{% endif %}
        sourceRef:
{% if gitless %}
          kind: OCIRepository
{% else %}
          kind: GitRepository
{% endif %}
          name: webapp-pr-<< inputs.id >>
{% if not gitless %}
        postBuild:
          substitute:
            PR_ID: "pr-<< inputs.id >>"
            PR_SHA: "<< printf \"'%.7s'\" inputs.sha >>"
            PREVIEW_DOMAIN: "{{ preview_domain }}"
            REGISTRY_URL: "{{ container_registry_url }}"
            APP_REPO: "{{ app_repo }}"
{% endif %}
        targetNamespace: webapp-pr-<< inputs.id >>
