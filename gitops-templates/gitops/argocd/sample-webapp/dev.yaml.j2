apiVersion: argoproj.io/v1alpha1
kind: Application
metadata:
  name: webapp-dev
  namespace: {{ gitops_namespace }}
spec:
  project: default
  source:
{% if gitless %}
    repoURL: {{ sample_webapp_dev_oci_url }}
    targetRevision: dev-latest
    path: .
    directory:
      recurse: true
{% else %}
    repoURL: {{ repo_url }}
    targetRevision: HEAD
    path: apps/sample-webapp/overlays/dev
{% endif %}
  destination:
    server: https://kubernetes.default.svc
    namespace: webapp-dev
  syncPolicy:
    automated:
      prune: true
      selfHeal: true
    syncOptions:
      - CreateNamespace=true
