apiVersion: kustomize.config.k8s.io/v1beta1
kind: Kustomization
namespace: webapp-prod
resources:
  - namespace.yaml
  - ../../base
images:
  - name: webapp
    newName: {{ container_registry_url }}/{{ app_repo }}
    newTag: none
patches:
  - patch: |-
      - op: replace
        path: /metadata/name
        value: webapp-prod
    target:
      kind: Deployment
  - patch: |-
      - op: replace
        path: /metadata/name
        value: webapp-prod
    target:
      kind: Service
  - patch: |-
      - op: replace
        path: /metadata/name
        value: webapp-prod
      - op: replace
        path: /spec/rules/0/host
        value: webapp-prod.{{ apps_domain }}
      - op: replace
        path: /spec/tls/0/hosts/0
        value: webapp-prod.{{ apps_domain }}
      - op: replace
        path: /spec/rules/0/http/paths/0/backend/service/name
        value: webapp-prod
    target:
      kind: Ingress
