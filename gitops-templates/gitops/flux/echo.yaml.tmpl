apiVersion: helm.toolkit.fluxcd.io/v2
kind: HelmRelease
metadata:
  name: echo
  namespace: {{ .gitops_namespace }}
spec:
  interval: 10m
  chart:
    spec:
      chart: app-template
      # renovate: datasource=helm depName=app-template registryUrl=https://bjw-s-labs.github.io/helm-charts/
      version: "5.0.0"
      sourceRef:
        kind: HelmRepository
        name: bjw-s
        namespace: {{ .gitops_namespace }}
  values:
    controllers:
      main:
        containers:
          main:
            image:
              repository: ealen/echo-server
              # renovate: datasource=docker depName=ealen/echo-server
              tag: "0.9.2"
    service:
      main:
        controller: main
        ports:
          http:
            port: 80
    ingress:
      main:
        enabled: true
        className: traefik
        annotations:
          traefik.ingress.kubernetes.io/router.entrypoints: websecure
          traefik.ingress.kubernetes.io/router.tls: "true"
        hosts:
          - host: echo.{{ .apps_domain }}
            paths:
              - path: /
                pathType: Prefix
                service:
                  identifier: main
                  port: http
        tls:
          - hosts:
              - echo.{{ .apps_domain }}
---
apiVersion: source.toolkit.fluxcd.io/v1
kind: HelmRepository
metadata:
  name: bjw-s
  namespace: {{ .gitops_namespace }}
spec:
  interval: 1h
  url: https://bjw-s-labs.github.io/helm-charts/
