{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended"
  ],
  "packageRules": [
    {
      "matchManagers": [
        "github-actions"
      ],
      "automerge": true,
      "automergeType": "pr",
      "platformAutomerge": true
    },
    {
      "matchUpdateTypes": [
        "minor",
        "patch"
      ],
      "automerge": true,
      "automergeType": "pr"
    },
    {
      "description": "ngrok's version comes from its official Homebrew cask file (plain-text Ruby, not a clean releases feed) -- semver-coerced so only the actual 'version \"X.Y.Z\"' line resolves, not every line the custom datasource sees.",
      "matchPackageNames": [
        "ngrok"
      ],
      "versioning": "semver-coerced"
    }
  ],
  "schedule": [
    "before 6am on Monday"
  ],
  "customManagers": [
    {
      "customType": "regex",
      "description": "Update Helm chart versions in catalog YAML files",
      "fileMatch": [
        "^catalog\\.yaml$",
        "^components\\.yaml$",
        "^prerequisites\\.yaml$",
        "^repositories\\.yaml$",
        "^examples\\.yaml$",
        "^workloads/.*\\.yaml$"
      ],
      "matchStrings": [
        "# renovate: datasource=(?<datasource>\\S+) depName=(?<depName>\\S+) repositoryUrl=(?<registryUrl>\\S+)\\s+version:\\s+\"(?<currentValue>[^\"]+)\"",
        "# renovate: datasource=(?<datasource>\\S+) depName=(?<depName>\\S+) repositoryUrl=(?<registryUrl>\\S+)\\s+version:\\s+(?<currentValue>[^\\s\"]+)",
        "# renovate: datasource=(?<datasource>\\S+) depName=(?<depName>\\S+)\\s+version:\\s+\"(?<currentValue>[^\"]+)\"",
        "# renovate: datasource=(?<datasource>\\S+) depName=(?<depName>\\S+)\\s+version:\\s+(?<currentValue>[^\\s\"]+)",
        "# renovate: datasource=(?<datasource>\\S+) depName=(?<depName>\\S+)\\s+tag:\\s+\"(?<currentValue>[^\"]+)\"",
        "# renovate: datasource=(?<datasource>\\S+) depName=(?<depName>\\S+)\\s+tag:\\s+(?<currentValue>[^\\s\"]+)",
        "# renovate: datasource=(?<datasource>\\S+) depName=(?<depName>[^\\s]+)\\s+image:\\s+[^:]+:(?<currentValue>[^\\s\"]+)"
      ]
    }
  ],
  "customDatasources": {
    "ngrok": {
      "defaultRegistryUrlTemplate": "https://raw.githubusercontent.com/ngrok/homebrew-ngrok/main/Casks/ngrok.rb",
      "format": "plain"
    }
  }
}
