apiVersion: argoproj.io/v1alpha1
kind: Application
metadata:
  name: webapp-prod
  namespace: {{ gitops_namespace }}
  annotations:
    argocd.argoproj.io/skip-reconcile: "true"  # removed on first promotion
spec:
  project: default
  source:
{% if gitless %}
    repoURL: {{ sample_webapp_prod_oci_url }}
    targetRevision: prod-latest
    path: .
    directory:
      recurse: true
{% else %}
    repoURL: {{ repo_url }}
    targetRevision: HEAD
    path: apps/sample-webapp/overlays/prod
{% endif %}
  destination:
    server: https://kubernetes.default.svc
    namespace: webapp-prod
  syncPolicy:
    automated:
      prune: true
      selfHeal: true
    syncOptions:
      - CreateNamespace=true
