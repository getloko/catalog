name: Hello World

on:
  push:
    branches: ["main"]
  workflow_dispatch:

jobs:
  hello:
    runs-on: loko-runner-small
    steps:
      - uses: actions/checkout@v6

      - name: Hello from {{ env_name }}
        run: |
          echo "Hello from loko environment: {{ env_name }}"
          echo "Apps domain: {{ apps_domain }}"
          echo "Runner: $(hostname)"
          echo "Date: $(date)"
