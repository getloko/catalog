apiVersion: kustomize.toolkit.fluxcd.io/v1
kind: Kustomization
metadata:
  name: loko-root
  namespace: {{ .gitops_namespace }}
spec:
  interval: 10m0s
{{- if .gitless }}
  path: ./
{{- else }}
  path: ./{{ .repo_layout.environment_dir }}
{{- end }}
  prune: true
  sourceRef:
{{- if .gitless }}
    kind: OCIRepository
{{- else }}
    kind: GitRepository
{{- end }}
    name: {{ .gitops_namespace }}
